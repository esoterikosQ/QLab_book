{"version":3,"kind":"Article","sha256":"697198cb5eed5359a8d8c089a0f640bd5925e041951c3d12f6fa4abfd2a1f7cb","slug":"matrix-operations","location":"/113-matrix_operations.md","dependencies":[],"frontmatter":{"title":"2.1.4. 행렬 연산","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/113-matrix_operations.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/113-matrix_operations.md","exports":[{"format":"md","filename":"113-matrix_operations.md","url":"/build/113-matrix_operation-460fe1af3fa24fe19b3960147ce148a1.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2.1.4.1. 행렬 곱 (Python 3.13)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O8hnEVClRA"}],"identifier":"id-2-1-4-1-python-3-13","label":"2.1.4.1. 행렬 곱 (Python 3.13)","html_id":"id-2-1-4-1-python-3-13","implicit":true,"key":"U7O0AIlatE"},{"type":"code","lang":"python","value":"import numpy as np\n\nA = np.array([[1, 2], [3, 4]])\nB = np.array([[5, 6], [7, 8]])\n\n# 행렬 곱 (A의 열 = B의 행)\nC = A @ B\nprint(C)\n# [[19, 22],\n#  [43, 50]]\n\n# 계산: C[0,0] = 1*5 + 2*7 = 19\n#      C[0,1] = 1*6 + 2*8 = 22","position":{"start":{"line":5,"column":1},"end":{"line":19,"column":1}},"key":"EWKwwJvnrW"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"2.1.4.2. 벡터-행렬 곱","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Ng1SacbBxQ"}],"identifier":"id-2-1-4-2","label":"2.1.4.2. 벡터-행렬 곱","html_id":"id-2-1-4-2","implicit":true,"key":"h4lSQGIubO"},{"type":"code","lang":"python","value":"A = np.array([[1, 2, 3],\n              [4, 5, 6]])\nx = np.array([1, 2, 3])\n\n# Ax (2x3 @ 3x1 = 2x1)\ny = A @ x\nprint(y)  # [14, 32]","position":{"start":{"line":23,"column":1},"end":{"line":31,"column":1}},"key":"ejtyMnzC0A"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"2.1.4.3. 행렬 거듭제곱","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ANqHBwRVWk"}],"identifier":"id-2-1-4-3","label":"2.1.4.3. 행렬 거듭제곱","html_id":"id-2-1-4-3","implicit":true,"key":"NmFc4ZQNgs"},{"type":"code","lang":"python","value":"A = np.array([[1, 2], [3, 4]])\n\n# A^2\nA2 = np.linalg.matrix_power(A, 2)\nprint(A2)\n\n# A^(-1) (역행렬)\nA_inv = np.linalg.matrix_power(A, -1)","position":{"start":{"line":35,"column":1},"end":{"line":44,"column":1}},"key":"pZcuahzNwL"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"2.1.4.4. 크로네커 곱","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"RP120lqhiu"}],"identifier":"id-2-1-4-4","label":"2.1.4.4. 크로네커 곱","html_id":"id-2-1-4-4","implicit":true,"key":"Yl8IYznTgp"},{"type":"code","lang":"python","value":"A = np.array([[1, 2], [3, 4]])\nB = np.array([[0, 5], [6, 7]])\n\nkron = np.kron(A, B)\nprint(kron)","position":{"start":{"line":48,"column":1},"end":{"line":54,"column":1}},"key":"o19UAxO728"},{"type":"heading","depth":2,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"2.1.4.5. 행렬 노름","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"LAI3dTxpUA"}],"identifier":"id-2-1-4-5","label":"2.1.4.5. 행렬 노름","html_id":"id-2-1-4-5","implicit":true,"key":"a6vMbMdfIh"},{"type":"code","lang":"python","value":"A = np.array([[1, 2], [3, 4]])\n\n# Frobenius norm\nfrob = np.linalg.norm(A, 'fro')\n\n# 2-norm (spectral norm)\nspec = np.linalg.norm(A, 2)\n\n# 무한대 노름\ninf = np.linalg.norm(A, np.inf)","position":{"start":{"line":58,"column":1},"end":{"line":69,"column":1}},"key":"n7MKpFl8pR"},{"type":"heading","depth":2,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"2.1.4.6. R에서의 행렬 연산","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"RIjsVFP0Co"}],"identifier":"id-2-1-4-6-r","label":"2.1.4.6. R에서의 행렬 연산","html_id":"id-2-1-4-6-r","implicit":true,"key":"I5hBBwNOx6"},{"type":"code","lang":"r","value":"A <- matrix(c(1, 2, 3, 4), nrow=2)\nB <- matrix(c(5, 6, 7, 8), nrow=2)\n\n# 행렬 곱\nC <- A %*% B\n\n# 요소별 곱\nH <- A * B\n\n# 크로네커 곱\nkron <- kronecker(A, B)\n\n# 행렬 거듭제곱\nlibrary(expm)\nA2 <- A %^% 2","position":{"start":{"line":73,"column":1},"end":{"line":89,"column":1}},"key":"eZIt79msC2"},{"type":"heading","depth":2,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"2.1.4.7. 블록 행렬 연산","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"IvixesTNfE"}],"identifier":"id-2-1-4-7","label":"2.1.4.7. 블록 행렬 연산","html_id":"id-2-1-4-7","implicit":true,"key":"C5fsC0wwL4"},{"type":"code","lang":"python","value":"# 블록 행렬 생성\nA11 = np.array([[1, 2], [3, 4]])\nA12 = np.array([[5, 6], [7, 8]])\nA21 = np.array([[9, 10], [11, 12]])\nA22 = np.array([[13, 14], [15, 16]])\n\n# 블록 결합\nA = np.block([[A11, A12],\n              [A21, A22]])","position":{"start":{"line":93,"column":1},"end":{"line":103,"column":1}},"key":"NdLyo3EjFy"}],"key":"GWby5TjhFL"}],"key":"X707pizCk1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2.1.3. 행렬","url":"/matrices","group":"Linear Algebra"},"next":{"title":"2.1.5. 고유값과 고유벡터","url":"/eigenvalues","group":"Linear Algebra"}}},"domain":"http://localhost:3000"}