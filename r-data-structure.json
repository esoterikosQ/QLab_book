{"version":3,"kind":"Article","sha256":"ab92d37974c36c8cdd53fd943a61926a7d2525601bf18cb20f45b506c13cc3e2","slug":"r-data-structure","location":"/041-r_data_structure.md","dependencies":[],"frontmatter":{"title":"1.4.2. R 자료구조","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/041-r_data_structure.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/041-r_data_structure.md","exports":[{"format":"md","filename":"041-r_data_structure.md","url":"/build/041-r_data_structure-8fe3c856122ebc4a02a85ae1ab152c55.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"R의 기본 자료구조는 벡터, 리스트, 행렬, 데이터 프레임, 팩터입니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XV6cPa2XNP"}],"key":"ix7xQrFRvN"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1.4.2.1. 벡터 (Vector)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MzUkjwNSnS"}],"identifier":"id-1-4-2-1-vector","label":"1.4.2.1. 벡터 (Vector)","html_id":"id-1-4-2-1-vector","implicit":true,"key":"W93aUEqpvT"},{"type":"code","lang":"r","value":"# 생성\nnums <- c(1, 2, 3, 4, 5)\nchars <- c(\"a\", \"b\", \"c\")\n\n# 명명\nnames(nums) <- c(\"first\", \"second\", \"third\", \"fourth\", \"fifth\")\nnamed_vec <- c(a=1, b=2, c=3)\n\n# 인덱싱\nnums[1]                  # 1 (1부터 시작)\nnums[c(1, 3, 5)]         # 1, 3, 5\nnums[nums > 2]           # 3, 4, 5\nnums[\"first\"]            # 이름으로 접근\n\n# 연산\nnums + 10\nnums * 2\nsum(nums)\nmean(nums)","position":{"start":{"line":7,"column":1},"end":{"line":27,"column":1}},"key":"MVZF4V79kM"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"1.4.2.2. 리스트 (List)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"SimqXOnbcR"}],"identifier":"id-1-4-2-2-list","label":"1.4.2.2. 리스트 (List)","html_id":"id-1-4-2-2-list","implicit":true,"key":"m22dFC0DzK"},{"type":"code","lang":"r","value":"# 생성\nperson <- list(\n    name = \"Alice\",\n    age = 25,\n    scores = c(85, 90, 88),\n    passed = TRUE\n)\n\n# 접근\nperson$name              # \"Alice\"\nperson[[1]]              # \"Alice\"\nperson[[\"name\"]]         # \"Alice\"\nperson[\"name\"]           # 리스트로 반환\n\n# 수정\nperson$age <- 26\nperson$city <- \"Seoul\"   # 새 요소 추가\n\n# 길이\nlength(person)           # 5\n\n# 리스트 결합\nlist1 <- list(a=1, b=2)\nlist2 <- list(c=3, d=4)\ncombined <- c(list1, list2)","position":{"start":{"line":31,"column":1},"end":{"line":57,"column":1}},"key":"K5a8o1bLga"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"1.4.2.3. 행렬 (Matrix)","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"lJmrrFHPHc"}],"identifier":"id-1-4-2-3-matrix","label":"1.4.2.3. 행렬 (Matrix)","html_id":"id-1-4-2-3-matrix","implicit":true,"key":"K694Iy9ZZD"},{"type":"code","lang":"r","value":"# 생성\nmat <- matrix(1:12, nrow=3, ncol=4)\n# mat <- matrix(1:12, nrow=3, byrow=TRUE)  # 행 우선\n\n# 차원 확인\ndim(mat)                 # c(3, 4)\nnrow(mat)                # 3\nncol(mat)                # 4\n\n# 인덱싱\nmat[1, 2]                # 1행 2열\nmat[1, ]                 # 1행 전체\nmat[, 2]                 # 2열 전체\nmat[c(1, 3), c(2, 4)]    # 특정 행/열\n\n# 행/열 이름\nrownames(mat) <- c(\"r1\", \"r2\", \"r3\")\ncolnames(mat) <- c(\"c1\", \"c2\", \"c3\", \"c4\")\n\n# 연산\nmat + 10\nmat * 2\nmat %*% t(mat)           # 행렬 곱\nt(mat)                   # 전치\n\n# 행/열 결합\nrbind(mat, c(13, 14, 15, 16))  # 행 추가\ncbind(mat, c(13, 14, 15))      # 열 추가\n\n# apply\napply(mat, 1, sum)       # 행별 합\napply(mat, 2, mean)      # 열별 평균","position":{"start":{"line":61,"column":1},"end":{"line":94,"column":1}},"key":"OqOKGJP1GS"},{"type":"heading","depth":2,"position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"1.4.2.4. 배열 (Array)","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"QVlDRlWRhV"}],"identifier":"id-1-4-2-4-array","label":"1.4.2.4. 배열 (Array)","html_id":"id-1-4-2-4-array","implicit":true,"key":"eqzNAVFGZc"},{"type":"code","lang":"r","value":"# 3차원 배열\narr <- array(1:24, dim=c(3, 4, 2))\n\n# 인덱싱\narr[1, 2, 1]\narr[, , 1]               # 첫 번째 슬라이스","position":{"start":{"line":98,"column":1},"end":{"line":105,"column":1}},"key":"rQA5zdsX5Z"},{"type":"heading","depth":2,"position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"1.4.2.5. 데이터 프레임 (Data Frame)","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"Vs0hODyX8p"}],"identifier":"id-1-4-2-5-data-frame","label":"1.4.2.5. 데이터 프레임 (Data Frame)","html_id":"id-1-4-2-5-data-frame","implicit":true,"key":"RppkN1gaX5"},{"type":"code","lang":"r","value":"# 생성\ndf <- data.frame(\n    name = c(\"Alice\", \"Bob\", \"Charlie\"),\n    age = c(25, 30, 35),\n    score = c(85.5, 92.0, 78.5),\n    passed = c(TRUE, TRUE, FALSE)\n)\n\n# 구조 확인\nstr(df)\nsummary(df)\nhead(df, 2)\ntail(df, 2)\ndim(df)\n\n# 열 접근\ndf$name\ndf[[\"name\"]]\ndf[, \"name\"]\ndf[, 1]\n\n# 행 접근\ndf[1, ]                  # 첫 행\ndf[c(1, 3), ]            # 1, 3행\n\n# 필터링\ndf[df$age > 25, ]\ndf[df$score >= 80, c(\"name\", \"score\")]\n\n# 열 추가/삭제\ndf$grade <- c(\"B\", \"A\", \"C\")\ndf$grade <- NULL         # 삭제\n\n# 행 추가\nnew_row <- data.frame(name=\"David\", age=28, score=88.0, passed=TRUE)\ndf <- rbind(df, new_row)\n\n# 정렬\ndf[order(df$score), ]              # 오름차순\ndf[order(-df$score), ]             # 내림차순\ndf[order(df$age, -df$score), ]     # 다중 정렬","position":{"start":{"line":109,"column":1},"end":{"line":151,"column":1}},"key":"pWaWZQPsHG"},{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"1.4.2.6. 팩터 (Factor)","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"hWpiSwhwI3"}],"identifier":"id-1-4-2-6-factor","label":"1.4.2.6. 팩터 (Factor)","html_id":"id-1-4-2-6-factor","implicit":true,"key":"cHY9TMt38B"},{"type":"code","lang":"r","value":"# 생성\ncolors <- factor(c(\"red\", \"blue\", \"red\", \"green\", \"blue\"))\n\n# 레벨 확인\nlevels(colors)           # \"blue\", \"green\", \"red\" (알파벳 순)\nnlevels(colors)          # 3\n\n# 레벨 순서 지정\ncolors <- factor(c(\"red\", \"blue\", \"red\", \"green\", \"blue\"),\n                 levels=c(\"red\", \"green\", \"blue\"))\n\n# 순서형 팩터\nsizes <- ordered(c(\"S\", \"M\", \"L\", \"M\", \"S\"),\n                 levels=c(\"S\", \"M\", \"L\"))\n\n# 팩터 → 문자열\nas.character(colors)\n\n# 문자열 → 팩터\nchars <- c(\"a\", \"b\", \"c\", \"a\")\nfactor(chars)","position":{"start":{"line":155,"column":1},"end":{"line":177,"column":1}},"key":"wPktACBGbA"},{"type":"heading","depth":2,"position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"children":[{"type":"text","value":"1.4.2.7. tibble (tidyverse)","position":{"start":{"line":179,"column":1},"end":{"line":179,"column":1}},"key":"a8MEAr5JBr"}],"identifier":"id-1-4-2-7-tibble-tidyverse","label":"1.4.2.7. tibble (tidyverse)","html_id":"id-1-4-2-7-tibble-tidyverse","implicit":true,"key":"wJVZGgy2Wd"},{"type":"code","lang":"r","value":"library(tibble)\n\n# 생성\ntbl <- tibble(\n    name = c(\"Alice\", \"Bob\", \"Charlie\"),\n    age = c(25, 30, 35),\n    score = c(85.5, 92.0, 78.5)\n)\n\n# 장점\n# 1. 출력이 깔끔 (많은 행도 자동으로 일부만 표시)\n# 2. 타입 변환 안 함 (문자열이 자동으로 factor가 되지 않음)\n# 3. 부분 매칭 안 됨 (tbl$nam은 오류)\n\n# tribble (행 단위 생성)\ntbl <- tribble(\n    ~name,      ~age, ~score,\n    \"Alice\",    25,   85.5,\n    \"Bob\",      30,   92.0,\n    \"Charlie\",  35,   78.5\n)\n\n# data.frame으로 변환\nas.data.frame(tbl)\n\n# tibble로 변환\nas_tibble(df)","position":{"start":{"line":181,"column":1},"end":{"line":209,"column":1}},"key":"gidxf21ZvH"},{"type":"heading","depth":2,"position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"1.4.2.8. 자료구조 변환","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"uaxIN7ezoN"}],"identifier":"id-1-4-2-8","label":"1.4.2.8. 자료구조 변환","html_id":"id-1-4-2-8","implicit":true,"key":"nebL7IMIHR"},{"type":"code","lang":"r","value":"# 벡터 → 행렬\nvec <- 1:12\nmat <- matrix(vec, nrow=3)\n\n# 행렬 → 데이터프레임\ndf <- as.data.frame(mat)\n\n# 리스트 → 데이터프레임\nlst <- list(a=1:3, b=4:6, c=7:9)\ndf <- as.data.frame(lst)\n\n# 데이터프레임 → 행렬\nmat <- as.matrix(df)\n\n# 팩터 → 숫자\nf <- factor(c(\"1\", \"2\", \"3\"))\nas.numeric(as.character(f))   # 올바른 방법","position":{"start":{"line":213,"column":1},"end":{"line":231,"column":1}},"key":"o831fuZZr4"},{"type":"heading","depth":2,"position":{"start":{"line":233,"column":1},"end":{"line":233,"column":1}},"children":[{"type":"text","value":"1.4.2.9. 결측치 처리","position":{"start":{"line":233,"column":1},"end":{"line":233,"column":1}},"key":"H4OHysFupp"}],"identifier":"id-1-4-2-9","label":"1.4.2.9. 결측치 처리","html_id":"id-1-4-2-9","implicit":true,"key":"UrvVO8bp70"},{"type":"code","lang":"r","value":"x <- c(1, 2, NA, 4, 5)\n\n# 결측치 확인\nis.na(x)                 # c(FALSE, FALSE, TRUE, FALSE, FALSE)\nanyNA(x)                 # TRUE\nsum(is.na(x))            # 1\n\n# 제거\nx[!is.na(x)]             # c(1, 2, 4, 5)\nna.omit(x)               # c(1, 2, 4, 5)\n\n# 데이터프레임\ndf <- data.frame(a=c(1, NA, 3), b=c(4, 5, NA))\ncomplete.cases(df)       # c(TRUE, FALSE, FALSE)\ndf[complete.cases(df), ]  # 완전한 행만\nna.omit(df)              # 결측치 행 제거\n\n# 대체\nx[is.na(x)] <- mean(x, na.rm=TRUE)","position":{"start":{"line":235,"column":1},"end":{"line":255,"column":1}},"key":"NNiPTRQYjm"},{"type":"heading","depth":2,"position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"children":[{"type":"text","value":"1.4.2.10. 자료구조 비교","position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"key":"sKbx9duWDi"}],"identifier":"id-1-4-2-10","label":"1.4.2.10. 자료구조 비교","html_id":"id-1-4-2-10","implicit":true,"key":"kqt34QHeZY"},{"type":"table","position":{"start":{"line":259,"column":1},"end":{"line":266,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"구조","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"yWmhtB0Rtj"}],"key":"qpOoojC7Yj"},{"type":"tableCell","header":true,"position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"차원","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"TrJ9sgFfLP"}],"key":"yL8aW4SOtU"},{"type":"tableCell","header":true,"position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"타입","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"AfSeD5Gast"}],"key":"E7ZaxHPr9r"},{"type":"tableCell","header":true,"position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"children":[{"type":"text","value":"가변성","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"KtOPvzhGpG"}],"key":"IHOSoJFCyy"}],"key":"KuiVzhNVsx"},{"type":"tableRow","position":{"start":{"line":261,"column":1},"end":{"line":261,"column":1}},"children":[{"type":"table