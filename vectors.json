{"version":3,"kind":"Article","sha256":"39c9462a397c82fd485686dff445552b039449357c2a11ce9f7287956ede227e","slug":"vectors","location":"/111-vectors.md","dependencies":[],"frontmatter":{"title":"2.1.2. 벡터","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/111-vectors.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/111-vectors.md","exports":[{"format":"md","filename":"111-vectors.md","url":"/build/111-vectors-838d7e72967aaab1f3cffac14afc287d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"벡터는 크기와 방향을 가진 양으로, 데이터 포인트나 특징을 표현하는 데 사용됩니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yKxPugLxxo"}],"key":"V8nucnCgW0"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"2.1.2.1. 벡터 기본 (Python 3.13)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"K8xrYLKhHY"}],"identifier":"id-2-1-2-1-python-3-13","label":"2.1.2.1. 벡터 기본 (Python 3.13)","html_id":"id-2-1-2-1-python-3-13","implicit":true,"key":"ylgqBSwmkB"},{"type":"code","lang":"python","value":"import numpy as np\n\n# 벡터 생성\nv = np.array([1, 2, 3])\nw = np.array([4, 5, 6])\n\n# 벡터 덧셈/뺄셈\nprint(v + w)  # [5, 7, 9]\nprint(v - w)  # [-3, -3, -3]\n\n# 스칼라 곱\nprint(2 * v)  # [2, 4, 6]\n\n# 내적 (dot product)\ndot = np.dot(v, w)  # 1*4 + 2*5 + 3*6 = 32\n# 또는\ndot = v @ w\n\n# 노름 (길이)\nnorm = np.linalg.norm(v)  # sqrt(1^2 + 2^2 + 3^2) = 3.74\n\n# 정규화 (단위 벡터)\nv_normalized = v / np.linalg.norm(v)","position":{"start":{"line":7,"column":1},"end":{"line":31,"column":1}},"key":"BBnWmE31Fo"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"2.1.2.2. 코사인 유사도","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"c6nQCzS5N4"}],"identifier":"id-2-1-2-2","label":"2.1.2.2. 코사인 유사도","html_id":"id-2-1-2-2","implicit":true,"key":"FVUiGLgJTP"},{"type":"code","lang":"python","value":"def cosine_similarity(v, w):\n    \"\"\"두 벡터 간 코사인 유사도\"\"\"\n    return np.dot(v, w) / (np.linalg.norm(v) * np.linalg.norm(w))\n\nv = np.array([1, 2, 3])\nw = np.array([4, 5, 6])\nsim = cosine_similarity(v, w)\nprint(f\"Cosine Similarity: {sim:.4f}\")","position":{"start":{"line":35,"column":1},"end":{"line":44,"column":1}},"key":"g85fn1nkY7"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"2.1.2.3. 외적 (3D 벡터)","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"O93rQc0SRU"}],"identifier":"id-2-1-2-3-3d","label":"2.1.2.3. 외적 (3D 벡터)","html_id":"id-2-1-2-3-3d","implicit":true,"key":"EVzg65RRK5"},{"type":"code","lang":"python","value":"# 외적 (cross product)\nv = np.array([1, 0, 0])\nw = np.array([0, 1, 0])\ncross = np.cross(v, w)  # [0, 0, 1]","position":{"start":{"line":48,"column":1},"end":{"line":53,"column":1}},"key":"kKjAYiAAok"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"2.1.2.4. R에서의 벡터","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"Ubeq7VPI1U"}],"identifier":"id-2-1-2-4-r","label":"2.1.2.4. R에서의 벡터","html_id":"id-2-1-2-4-r","implicit":true,"key":"rALYME8A8S"},{"type":"code","lang":"r","value":"# 벡터 생성\nv <- c(1, 2, 3)\nw <- c(4, 5, 6)\n\n# 연산\nv + w\nv - w\n2 * v\n\n# 내적\nsum(v * w)  # 32\n\n# 노름\nsqrt(sum(v^2))\n\n# 정규화\nv / sqrt(sum(v^2))","position":{"start":{"line":57,"column":1},"end":{"line":75,"column":1}},"key":"e8UUxEHTj4"},{"type":"heading","depth":2,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"2.1.2.5. 벡터 투영","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Ud7eqkDMSn"}],"identifier":"id-2-1-2-5","label":"2.1.2.5. 벡터 투영","html_id":"id-2-1-2-5","implicit":true,"key":"vd7etlWSex"},{"type":"code","lang":"python","value":"def vector_projection(v, w):\n    \"\"\"v를 w에 투영\"\"\"\n    return (np.dot(v, w) / np.dot(w, w)) * w\n\nv = np.array([3, 4])\nw = np.array([1, 0])\nproj = vector_projection(v, w)\nprint(proj)  # [3, 0]","position":{"start":{"line":79,"column":1},"end":{"line":88,"column":1}},"key":"NvGvIpb3fW"}],"key":"G8EpXQYMjY"}],"key":"DV6Ev1Ku6j"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2.1. 선형대수 소개","url":"/intro-3","group":"Linear Algebra"},"next":{"title":"2.1.3. 행렬","url":"/matrices","group":"Linear Algebra"}}},"domain":"http://localhost:3000"}