{"version":3,"kind":"Article","sha256":"7a0688145a63324c57ee3aa078e08d0e4d6824c5e84bb4b68eca1204c9d861c4","slug":"ggplot","location":"/061-ggplot.md","dependencies":[],"frontmatter":{"title":"1.6.2. ggplot2 (R)","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/061-ggplot.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/061-ggplot.md","exports":[{"format":"md","filename":"061-ggplot.md","url":"/build/061-ggplot-3a1ea05512dd1d851d3e2b9a8dc6496d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"ggplot2는 \"Grammar of Graphics\"에 기반한 R의 강력한 시각화 패키지입니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"K5HmNVN8BB"}],"key":"ebAyLvtHJy"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1.6.2.1. 기본 구조","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"F7eYs8OxwN"}],"identifier":"id-1-6-2-1","label":"1.6.2.1. 기본 구조","html_id":"id-1-6-2-1","implicit":true,"key":"qoMKqKc7YN"},{"type":"code","lang":"r","value":"library(ggplot2)\n\n# 기본 템플릿\nggplot(data = <DATA>) +\n    <GEOM_FUNCTION>(mapping = aes(<MAPPINGS>))\n\n# 예제\nggplot(mtcars, aes(x = wt, y = mpg)) +\n    geom_point()","position":{"start":{"line":7,"column":1},"end":{"line":17,"column":1}},"key":"TZ5fAk3WcB"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"1.6.2.2. 산점도","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Py3LuSEUDC"}],"identifier":"id-1-6-2-2","label":"1.6.2.2. 산점도","html_id":"id-1-6-2-2","implicit":true,"key":"ZI2fFmKEeU"},{"type":"code","lang":"r","value":"# 기본 산점도\nggplot(mtcars, aes(x = wt, y = mpg)) +\n    geom_point() +\n    labs(title = \"Weight vs MPG\", x = \"Weight (1000 lbs)\", y = \"Miles per Gallon\")\n\n# 색상과 크기 매핑\nggplot(mtcars, aes(x = wt, y = mpg, color = factor(cyl), size = hp)) +\n    geom_point(alpha = 0.6) +\n    theme_minimal()\n\n# 추세선 추가\nggplot(mtcars, aes(x = wt, y = mpg)) +\n    geom_point() +\n    geom_smooth(method = \"lm\", se = TRUE) +\n    theme_bw()","position":{"start":{"line":21,"column":1},"end":{"line":37,"column":1}},"key":"qDGWXLY7h9"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"1.6.2.3. 막대 차트","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"oSPYiqOgJm"}],"identifier":"id-1-6-2-3","label":"1.6.2.3. 막대 차트","html_id":"id-1-6-2-3","implicit":true,"key":"fJfPz0iErL"},{"type":"code","lang":"r","value":"# 카운트 막대 차트\nggplot(mtcars, aes(x = factor(cyl))) +\n    geom_bar() +\n    labs(x = \"Cylinders\", y = \"Count\")\n\n# 그룹별 막대 차트\nggplot(mtcars, aes(x = factor(cyl), fill = factor(gear))) +\n    geom_bar(position = \"dodge\") +\n    scale_fill_brewer(palette = \"Set2\")\n\n# 수평 막대 차트\nggplot(mtcars, aes(x = reorder(rownames(mtcars), mpg), y = mpg)) +\n    geom_col() +\n    coord_flip() +\n    labs(x = \"Car Model\", y = \"MPG\")","position":{"start":{"line":41,"column":1},"end":{"line":57,"column":1}},"key":"GDlq531e4v"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"1.6.2.4. 히스토그램과 밀도 플롯","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"pvSdTSn5VC"}],"identifier":"id-1-6-2-4","label":"1.6.2.4. 히스토그램과 밀도 플롯","html_id":"id-1-6-2-4","implicit":true,"key":"M1huj9jRDQ"},{"type":"code","lang":"r","value":"# 히스토그램\nggplot(iris, aes(x = Sepal.Length)) +\n    geom_histogram(bins = 30, fill = \"steelblue\", color = \"white\") +\n    theme_minimal()\n\n# 밀도 플롯\nggplot(iris, aes(x = Sepal.Length, fill = Species)) +\n    geom_density(alpha = 0.5) +\n    theme_minimal()\n\n# 박스플롯\nggplot(iris, aes(x = Species, y = Sepal.Length, fill = Species)) +\n    geom_boxplot() +\n    theme_classic()","position":{"start":{"line":61,"column":1},"end":{"line":76,"column":1}},"key":"SDRvibxgbZ"},{"type":"heading","depth":2,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"1.6.2.5. Facet (면 분할)","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"zMbjetWnVy"}],"identifier":"id-1-6-2-5-facet","label":"1.6.2.5. Facet (면 분할)","html_id":"id-1-6-2-5-facet","implicit":true,"key":"m6xhZZjzBK"},{"type":"code","lang":"r","value":"# 행으로 분할\nggplot(mtcars, aes(x = wt, y = mpg)) +\n    geom_point() +\n    facet_wrap(~ cyl)\n\n# 행과 열로 분할\nggplot(mtcars, aes(x = wt, y = mpg)) +\n    geom_point() +\n    facet_grid(cyl ~ gear)","position":{"start":{"line":80,"column":1},"end":{"line":90,"column":1}},"key":"XTfd1FcqdO"},{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"1.6.2.6. 테마와 스타일","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"TchbZMLje8"}],"identifier":"id-1-6-2-6","label":"1.6.2.6. 테마와 스타일","html_id":"id-1-6-2-6","implicit":true,"key":"TnNQXF7r8k"},{"type":"code","lang":"r","value":"library(ggthemes)\n\n# 내장 테마\np <- ggplot(mtcars, aes(x = wt, y = mpg)) + geom_point()\np + theme_minimal()\np + theme_classic()\np + theme_bw()\n\n# 확장 테마\np + theme_economist()\np + theme_fivethirtyeight()","position":{"start":{"line":94,"column":1},"end":{"line":106,"column":1}},"key":"yEfBK0Hlpm"},{"type":"heading","depth":2,"position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"1.6.2.7. 저장","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"YGwfR3mwSu"}],"identifier":"id-1-6-2-7","label":"1.6.2.7. 저장","html_id":"id-1-6-2-7","implicit":true,"key":"XKjc2FniFE"},{"type":"code","lang":"r","value":"# 기본 저장\nggsave(\"plot.png\", width = 8, height = 6, dpi = 300)\n\n# 특정 플롯 저장\np <- ggplot(mtcars, aes(x = wt, y = mpg)) + geom_point()\nggsave(\"scatter.pdf\", plot = p, width = 10, height = 8)","position":{"start":{"line":110,"column":1},"end":{"line":117,"column":1}},"key":"t9d6fgfAEY"}],"key":"kuYkNv7S6k"}],"key":"luhR9MXeqN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"1.6.1. 데이터 시각화 기초","url":"/structure","group":"Data Visualization"},"next":{"title":"1.6.3. matplotlib (Python)","url":"/matplotlib","group":"Data Visualization"}}},"domain":"http://localhost:3000"}