{"version":3,"kind":"Article","sha256":"1af2c39842755b49648ad28ea1421dbca1a67cd25535b84df1f698244ca7544a","slug":"c-intro","location":"/050-c_intro.md","dependencies":[],"frontmatter":{"title":"1.5.1. C/C++ 소개","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/050-c_intro.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/050-c_intro.md","exports":[{"format":"md","filename":"050-c_intro.md","url":"/build/050-c_intro-8bfb786c0db19903f5cae8ba03ef6b26.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"C/C++는 시스템 프로그래밍과 고성능 컴퓨팅에 사용되는 저수준 언어입니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xFZWDRzFjb"}],"key":"ZiA0iQE7Kf"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1.5.1.1. 설치 (Ubuntu 24.04)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZZbOoqkHxo"}],"identifier":"id-1-5-1-1-ubuntu-24-04","label":"1.5.1.1. 설치 (Ubuntu 24.04)","html_id":"id-1-5-1-1-ubuntu-24-04","implicit":true,"key":"CH7Q3vPx8J"},{"type":"code","lang":"bash","value":"# GCC/G++ 설치\nsudo apt update\nsudo apt install -y build-essential gdb\n\n# 버전 확인\ngcc --version   # gcc (Ubuntu 13.2.0) \ng++ --version   # g++ (Ubuntu 13.2.0)\n\n# CMake 설치\nsudo apt install -y cmake\n\n# 추가 도구\nsudo apt install -y valgrind  # 메모리 검사\nsudo apt install -y clang clang-format  # 대체 컴파일러","position":{"start":{"line":7,"column":1},"end":{"line":22,"column":1}},"key":"CRzpDhZdtw"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"1.5.1.2. 기본 문법 (C)","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"nl0KmcWEPc"}],"identifier":"id-1-5-1-2-c","label":"1.5.1.2. 기본 문법 (C)","html_id":"id-1-5-1-2-c","implicit":true,"key":"jwVoSmViLl"},{"type":"code","lang":"c","value":"#include <stdio.h>\n#include <stdlib.h>\n\nint main() {\n    // 변수\n    int x = 42;\n    float y = 3.14;\n    char c = 'A';\n    char str[] = \"Hello\";\n    \n    // 출력\n    printf(\"x = %d\\n\", x);\n    printf(\"y = %.2f\\n\", y);\n    printf(\"c = %c\\n\", c);\n    printf(\"str = %s\\n\", str);\n    \n    // 조건문\n    if (x > 0) {\n        printf(\"Positive\\n\");\n    } else if (x < 0) {\n        printf(\"Negative\\n\");\n    } else {\n        printf(\"Zero\\n\");\n    }\n    \n    // 반복문\n    for (int i = 0; i < 5; i++) {\n        printf(\"%d \", i);\n    }\n    printf(\"\\n\");\n    \n    return 0;\n}","position":{"start":{"line":26,"column":1},"end":{"line":60,"column":1}},"key":"REVSv9ERt5"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"1.5.1.3. 컴파일 및 실행","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"Ch1Sn9Lb1C"}],"identifier":"id-1-5-1-3","label":"1.5.1.3. 컴파일 및 실행","html_id":"id-1-5-1-3","implicit":true,"key":"DkCcsVvoAm"},{"type":"code","lang":"bash","value":"# C 컴파일\ngcc program.c -o program\n./program\n\n# 최적화\ngcc -O2 program.c -o program\n\n# 디버그 정보 포함\ngcc -g program.c -o program\ngdb ./program\n\n# 경고 활성화\ngcc -Wall -Wextra program.c -o program\n\n# C++ 컴파일\ng++ program.cpp -o program -std=c++20","position":{"start":{"line":64,"column":1},"end":{"line":81,"column":1}},"key":"BaYxZikvb4"},{"type":"heading","depth":2,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"1.5.1.4. C++ 기본","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"c3NQIBymxO"}],"identifier":"id-1-5-1-4-c","label":"1.5.1.4. C++ 기본","html_id":"id-1-5-1-4-c","implicit":true,"key":"xdHiQfGGdf"},{"type":"code","lang":"cpp","value":"#include <iostream>\n#include <vector>\n#include <string>\n\nint main() {\n    // auto 타입 추론\n    auto x = 42;\n    \n    // 벡터\n    std::vector<int> nums = {1, 2, 3, 4, 5};\n    \n    // Range-based for loop\n    for (const auto& num : nums) {\n        std::cout << num << \" \";\n    }\n    std::cout << std::endl;\n    \n    // 문자열\n    std::string name = \"Alice\";\n    std::cout << \"Hello, \" << name << std::endl;\n    \n    return 0;\n}","position":{"start":{"line":85,"column":1},"end":{"line":109,"column":1}},"key":"KOTrZ7vyrK"}],"key":"Tr9vUCz2nn"}],"key":"jqHmeSnAfT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"1.4.5. R 패키지 관리","url":"/r-packages","group":"R"},"next":{"title":"1.5.2. C/C++ 자료구조","url":"/c-data-structure","group":"C/C++"}}},"domain":"http://localhost:3000"}