rson r: {pearson_r:.4f}\")\n\n# 스피어만\nspearman_r, p_value = stats.spearmanr(x, y)\nprint(f\"Spearman r: {spearman_r:.4f}\")","position":{"start":{"line":127,"column":1},"end":{"line":139,"column":1}},"key":"z9vbmTQV8Q"},{"type":"code","lang":"r","value":"# R\nx <- c(1, 2, 3, 4, 5)\ny <- c(2, 4, 5, 4, 5)\n\n# 피어슨\ncor(x, y, method=\"pearson\")\n\n# 스피어만\ncor(x, y, method=\"spearman\")","position":{"start":{"line":141,"column":1},"end":{"line":151,"column":1}},"key":"RwKiPsGmxi"}],"key":"dJQahUdrIG"}],"key":"dfEFxjnaij"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2.1.5. 고유값과 고유벡터","url":"/eigenvalues","group":"Linear Algebra"},"next":{"title":"상관검정 통계량 유도","url":"/correlation","group":"Mathematical Statistics"}}},"domain":"http://localhost:3000"}