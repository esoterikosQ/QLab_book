.13","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"iXITdUKKc7"}],"identifier":"python-3-13","label":"Python 3.13","html_id":"python-3-13","implicit":true,"key":"rhYQngXzUi"},{"type":"code","lang":"python","value":"import numpy as np\nimport scipy.stats as stats\n\ndata = np.array([2, 4, 4, 4, 5, 5, 7, 9])\n\n# 중심 경향\nprint(f\"평균: {np.mean(data):.2f}\")       # 5.00\nprint(f\"중앙값: {np.median(data):.2f}\")   # 4.50\nmode_result = stats.mode(data, keepdims=True)\nprint(f\"최빈값: {mode_result.mode[0]}\")   # 4\n\n# 산포도\nprint(f\"분산: {np.var(data, ddof=1):.2f}\")  # 4.00\nprint(f\"표준편차: {np.std(data, ddof=1):.2f}\")  # 2.00\nprint(f\"범위: {np.ptp(data)}\")             # 7\n\n# 분위수\nprint(f\"25%: {np.percentile(data, 25)}\")\nprint(f\"75%: {np.percentile(data, 75)}\")","position":{"start":{"line":11,"column":1},"end":{"line":31,"column":1}},"key":"LxWIyXV7cK"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"R 4.25.4","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"qYUlxqRa7o"}],"identifier":"r-4-25-4","label":"R 4.25.4","html_id":"r-4-25-4","implicit":true,"key":"gNmL2xMafi"},{"type":"code","lang":"r","value":"data <- c(2, 4, 4, 4, 5, 5, 7, 9)\n\n# 중심 경향\nmean(data)\nmedian(data)\ntable(data)  # 빈도\n\n# 산포도\nvar(data)\nsd(data)\nrange(data)\n\n# 사분위수\nquantile(data, c(0.25, 0.75))\n\n# 요약\nsummary(data)","position":{"start":{"line":35,"column":1},"end":{"line":53,"column":1}},"key":"UuoUfLqmNT"},{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"2.2.2. 확률 분포","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"zc0Wz8kGuO"}],"identifier":"id-2-2-2","label":"2.2.2. 확률 분포","html_id":"id-2-2-2","implicit":true,"key":"dzUUm52IJG"},{"type":"heading","depth":3,"position":{"start":{"line":57,"column":1},"end":{"line":57,