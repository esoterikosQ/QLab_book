 anyDuplicated(qualified$player_id) == 0L,\n  all(is.finite(qualified$wOBA))\n)","key":"FbPE4P1b22"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"2. 포지션별 타석으로 주 포지션 정하기","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"iwurNVTBuF"}],"identifier":"id-2","label":"2. 포지션별 타석으로 주 포지션 정하기","html_id":"id-2","implicit":true,"key":"XjP7YTQodI"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"여러 포지션에서 뛴 선수는 ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"GZoHNv2nmu"},{"type":"strong","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"가장 많은 타석을 기록한 포지션","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ED5IaZOZmI"}],"key":"wNQojZEIGV"},{"type":"text","value":"에 배정한다. 비교할 집단은 포수(C), 1루수(1B), 2루수(2B), 3루수(3B), 유격수(SS), 좌익수(LF), 중견수(CF), 우익수(RF), 지명타자(DH)이다. 타석 수가 같으면 아래 코드에 나열된 순서에서 앞선 포지션을 선택한다. ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"SWbpuHAvXd"},{"type":"link","url":"https://billpetti.github.io/baseballr/reference/mlb_stats.html","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"inlineCode","value":"mlb_stats()","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"xIKoQvtIUX"},{"type":"text","value":" 문서","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"wV0SOj3SO7"}],"urlSource":"https://billpetti.github.io/baseballr/reference/mlb_stats.html","key":"M4KEZVEm06"},{"type":"text","value":" · ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"NVRuf0u2KL"},{"type":"link","url":"https://statsapi.mlb.com/api/v1/situationCodes","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"MLB 포지션별 타격 조건 코드","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"svmK5XoGp0"}],"urlSource":"https://statsapi.mlb.com/api/v1/situationCodes","key":"HSIs2QfgHG"}],"key":"a1YJvyj0hs"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"MLB 공식 API에서 ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"dMtrVEJOYl"},{"type":"inlineCode","value":"player_pool = \"QUALIFIED\"","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"qCrHd2Fn9q"},{"type":"text","value":"를 지정하면 규정타석 타자의 선수·포지션별 시즌 집계를 한 번에 받을 수 있다. 2026년 응답의 321행이 전체 타자 조회에서 분석 대상 135명만 골라낸 기록과 일치하는 것을 확인했다. 응답의 ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"lHq2hJGZ3J"},{"type":"inlineCode","value":"total_splits","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Wi05awYJ88"},{"type":"text","value":"와 실제 행 수를 비교해 누락을 확인한다.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"RBdaUs4C4J"}],"key":"drssGYRsE2"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"선수별로 포지션 타석 수가 큰 행을 먼저 오게 정렬한 다음, ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"SjlOkBoBW1"},{"type":"inlineCode","value":"distinct()","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"JYfxpnTSwd"},{"type":"text","value":"로 각 선수의 첫 행을 남긴다. 기록이 한 행인 선수는 그 포지션에 배정된다.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"ph96Xssg4H"}],"key":"qlP3gxktLs"},{"type":"code","lang":"r","value":"position_codes <- c(\n  p2 = \"C\", p3 = \"1B\", p4 = \"2B\", p5 = \"3B\", p6 = \"SS\",\n  p7 = \"LF\", p8 = \"CF\", p9 = \"RF\", pD = \"DH\"\n)\nsplits <- mlb_stats(\n  stat_type = \"statSplits\", stat_group = \"hitting\", player_pool = \"QUALIFIED\",\n  game_type = \"R\", season = season, sport_ids = 1,\n  sit_codes = names(position_codes)\n)\nif (is.null(splits) || nrow(splits) == 0L) {\n  stop(\"MLB 포지션별 타석 데이터를 불러오지 못했습니다.\")\n}\nstopifnot(\n  all(splits$total_splits == nrow(splits)),\n  anyDuplicated(splits[c(\"player_id\", \"split_code\")]) == 0L\n)\n\n# 포지션별 타석이 가장 많은 곳을 주 포지션으로 배정한다.\n# 공동 1위는 position_codes에 적힌 순서에서 앞선 포지션을 선택한다.\nprimary_positions <- splits |>\n  semi_join(qualified, by = \"player_id\") |>\n  filter(split_code %in% names(position_codes), plate_appearances > 0) |>\n  mutate(position = factor(\n    unname(position_codes[split_code]), levels = unname(position_codes)\n  )) |>\n  arrange(player_id, desc(plate_appearances), position) |>\n  distinct(player_id, .keep_all = TRUE) |>\n  select(player_id, position)\n\nplayers <- qualified |>\n  left_join(primary_positions, by = \"player_id\")\nstopifnot(!anyNA(players$position))","key":"k1IpTbBnKi"},{"type":"heading","depth":2,"position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"3. 포지션별 분포와 일원분산분석","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"hY1aEegh2K"}],"identifier":"id-3","label":"3. 포지션별 분포와 일원분산분석","html_id":"id-3","implicit":true,"key":"PeglRhaumn"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"포지션별 선수 수, 평균, 표준편차를 구하고 상자그림으로 분포를 비교한다.","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"e93bHNxhMv"}],"key":"nOeQewHIOZ"},{"type":"code","lang":"r","value":"position_summary <- players |>\n  group_by(position) |>\n  summarise(n = n(), mean_wOBA = mean(wOBA), sd_wOBA = sd(wOBA), .groups = \"drop\")\nprint(as.data.frame(position_summary), row.names = FALSE)\n\nboxplot(wOBA ~ position, data = players, xlab = \"Position\", ylab = \"wOBA\")","key":"peoIqT9yFX"},{"type":"paragraph","position":{"start":{"line":