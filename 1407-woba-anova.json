ww.mlb.com/glossary/standard-stats/rate-stats-qualifiers","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"MLB 규정타석 기준","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"hoHKqHH45F"}],"urlSource":"https://www.mlb.com/glossary/standard-stats/rate-stats-qualifiers","key":"KgLSw1UmB6"}],"key":"S5tTuc3cVW"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"관측 단위는 선수 한 명이다. 선수마다 주 포지션 하나와 시즌 전체 wOBA 하나를 사용하며, 포지션별 평균을 계산할 때 선수에게 같은 가중치를 준다. RStudio에서 아래 R 코드 블록을 위에서부터 실행하면 된다. 데이터 조회에는 인터넷 연결이 필요하다.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"h3q37CWkt4"}],"key":"JZ5G6P609D"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"1. FanGraphs에서 규정타석 타자의 wOBA 가져오기","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"rHXpkkvzRn"}],"identifier":"id-1-fangraphs-woba","label":"1. FanGraphs에서 규정타석 타자의 wOBA 가져오기","html_id":"id-1-fangraphs-woba","implicit":true,"key":"LyQvg3u1kc"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"baseballr","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"oNyBQfoysn"},{"type":"text","value":"의 ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"RIUUOKQo6d"},{"type":"inlineCode","value":"fg_batter_leaders()","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"BWOgox1CfC"},{"type":"text","value":"로 두 리그를 합산한 시즌 타격 기록을 가져온다. MLB 공식 기록과 연결하기 위해 FanGraphs 응답의 MLBAM 선수 ID(","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"lD9G5S3r97"},{"type":"inlineCode","value":"xMLBAMID","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"uH3NpUO0r1"},{"type":"text","value":")를 남긴다. ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"VbXSnXtVYP"},{"type":"link","url":"https://www.fangraphs.com/leaders/major-league?pos=all&stats=bat&lg=all&qual=y&type=8&season=2026&month=0&season1=2026&ind=0","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"2026년 FanGraphs 타격 리더보드","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Z139DNVpZ4"}],"urlSource":"https://www.fangraphs.com/leaders/major-league?pos=all&stats=bat&lg=all&qual=y&type=8&season=2026&month=0&season1=2026&ind=0","key":"s52fuId8O5"},{"type":"text","value":" · ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"JWc7YtEWrN"},{"type":"link","url":"https://billpetti.github.io/baseballr/reference/fg_batter_leaders.html","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"fg_batter_leaders()","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"MIHg9shsRN"},{"type":"text","value":" 문서","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"VroGz97EcE"}],"urlSource":"https://billpetti.github.io/baseballr/reference/fg_batter_leaders.html","key":"rLrxVqPkCk"}],"key":"mt8W5NUjal"},{"type":"code","lang":"r","value":"# 패키지 설치가 필요한 경우 실행\n# install.packages(c(\"baseballr\", \"dplyr\"))\nlibrary(baseballr)\nlibrary(dplyr)\n\nseason <- 2026\nmin_pa <- round(3.1 * 162)\nalpha <- 0.05\n\nbatting <- fg_batter_leaders(\n  startseason = season, endseason = season, lg = \"all\",\n  qual = as.character(min_pa), ind = \"0\"\n)\nif (is.null(batting) || nrow(batting) == 0L) {\n  stop(\"FanGraphs 타격 데이터를 불러오지 못했습니다.\")\n}\n\nqualified <- batting |>\n  filter(PA >= min_pa) |>\n  select(player_id = xMLBAMID, player = PlayerName, PA, wOBA)\nstopifnot(\n  nrow(qualified) > 0L,\n  !anyNA(qualified$player_id),\n  anyDuplicated(qualified$player_id) == 0L,\n  all(is.finite(qualified$wOBA))\n)","key":"SKgcNWk5fq"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"2. 포지션별 타석으로 주 포지션 정하기","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"un3T3SIx2e"}],"identifier":"id-2","label":"2. 포지션별 타석으로 주 포지션 정하기","html_id":"id-2","implicit":true,"key":"d4Jj27toaP"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"여러 포지션에서 뛴 선수는 ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"khzjsZyBYj"},{"type":"strong","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"가장 많은 타석을 기록한 포지션","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"wzzEyOQfJk"}],"key":"EJVOqWy7eR"},{"type":"text","value":"에 배정한다. 비교할 집단은 포수(C), 1루수(1B), 2루수(2B), 3루수(3B), 유격수(SS), 좌익수(LF), 중견수(CF), 우익수(RF), 지명타자(DH)이다. 타석 수가 같으면 아래 코드에 나열된 순서에서 앞선 포지션을 선택한다. ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"w5JvFyDwmG"},{"type":"link","url":"https://billpetti.github.io/baseballr/reference/mlb_stats.html","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"inlineCode","value":"mlb_stats()","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"CywSuSewdX"},{"type":"text","value":" 문서","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"WolSzrwk0m"}],"urlSource":"https://billpetti.github.io/baseballr/reference/mlb_stats.html","key":"IFPg6eFGW1"},{"type":"text","value":" · ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"njDM3Au66P"},{"type":"link","url":"https://statsapi.mlb.com/api/v1/situationCodes","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"MLB 포지션별 타격 조건 코드","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"pCSbzrVteK"}],"urlSource":"https://statsapi.mlb.com/api/v1/situationCodes","key":"ZwDViQS3e3"}],"key":"qPLVDuGD4u"},{"type":"code","lang":"r","value":"position_codes <- c(\n  p2 = \"C\", p3 = \"1B\", p4 = \"2B\", p5 = \"3B\", p6 = \"SS\",\n  p7 = \"LF\", p8 = \"CF\", p9 = \"RF\", pD = \"DH\"\n)\nsplits <- mlb_stats(\n  stat_type = \"statSplits\", stat_group = \"hitting\", player_pool = \"ALL\",\n  game_type = \"R\", season = season, sport_ids = 1,\n  sit_codes = names(position_codes), limit = 10000\n)\nif (is.null(splits) || nrow(splits) == 0L) {\n  stop(\"MLB 포지션별 타석 데이터를 불러오지 못했습니다.\")\n}\nstopifnot(\n  nrow(splits) == unique(splits$total_splits),\n  anyDuplicated(splits[c(\"player_id\", \"split_code\")]) == 0L\n)\n\n# 선수별로 타석이 많은 포지션부터 정렬한 뒤 첫 행을 선택한다.\nprimary_positions <- splits |>\n  filter(split_code %in% names(position_codes), plate_appearances > 0) |>\n  mutate(position = factor(\n    unname(position_codes[split_code]), levels = unname(position_codes)\n  )) |>\n  arrange(player_id, desc(plate_appearances), position) |>\n  distinct(player_id, .keep_all = TRUE) |>\n  select(player_id, position)\n\nplayers <- qualified |>\n  left_join(primary_positions, by = \"player_id\")\nstopifnot(!anyNA(players$position))","key":"qr3tOKRsDu"},{"type":"heading","depth":2,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"3. 포지션별 분포와 일원분산분석","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"rAixl3NKqo"}],"identifier":"id-3","label":"3. 포지션별 분포와 일원분산분석","html_id":"id-3","implicit":true,"key":"uZsilxTIiG"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"포지션별 선수 수, 평균, 표준편차를 구하고 상자그림으로 분포를 비교한다.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"k