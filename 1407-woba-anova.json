 c(\n  p2 = \"C\", p3 = \"1B\", p4 = \"2B\", p5 = \"3B\", p6 = \"SS\",\n  p7 = \"LF\", p8 = \"CF\", p9 = \"RF\", pD = \"DH\"\n)\n\nsplits <- mlb_stats(\n  stat_type = \"statSplits\", stat_group = \"hitting\", player_pool = \"QUALIFIED\",\n  game_type = \"R\", season = 2026, sport_ids = 1,\n  sit_codes = names(position_codes)\n)","key":"UTfNSKhZGJ"},{"type":"heading","depth":3,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"2. 데이터 정제 : 주 포지션 결정 및 wOBA와 결합","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"aW4UbwUdY4"}],"identifier":"id-2-woba","label":"2. 데이터 정제 : 주 포지션 결정 및 wOBA와 결합","html_id":"id-2-woba","implicit":true,"key":"FSsC0Aa8Do"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"inlineCode","value":"splits","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"yGNQdWYzb1"},{"type":"text","value":"의 PA값을 기준으로 주표지션을 결정한 데이터 ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"sGPPnMXfU3"},{"type":"inlineCode","value":"primary_positions","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"mzsYCX4sUT"},{"type":"text","value":"를 생성합니다.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"uJylEBbAbr"}],"key":"OACsv0Vcxh"},{"type":"code","lang":"r","value":"primary_positions <- splits %>%\n  semi_join(qualified, by = \"player_id\") %>%\n  filter(split_code %in% names(position_codes), plate_appearances > 0) %>%\n  mutate(position = factor(\n    unname(position_codes[split_code]), levels = unname(position_codes)\n  )) %>%\n  arrange(player_id, desc(plate_appearances), position) %>%\n  distinct(player_id, .keep_all = TRUE) %>%\n  select(player_id, position)","key":"IDPBOTDH9g"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"inlineCode","value":"qualified","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"aZLDfpcdif"},{"type":"text","value":"와 ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"MP6nTDlsUj"},{"type":"inlineCode","value":"primary_positions","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"iwTWQELMH2"},{"type":"text","value":"를 결합하여 각 선수의 주 포지션과 wOBA를 정리한 최종 데이터를 완성합니다.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"TupplU8Smd"}],"key":"tUgoDyssIv"},{"type":"code","lang":"r","value":"players <- qualified %>%\n  left_join(primary_positions, by = \"player_id\")","key":"TUeqXULqwV"},{"type":"heading","depth":3,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"3. 데이터 탐색","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"cSblRrHrbi"}],"identifier":"id-3","label":"3. 데이터 탐색","html_id":"id-3","implicit":true,"key":"qRJBKlHrKS"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"inlineCode","value":"players","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"m9NNpqLJyo"},{"type":"text","value":"의 요약 통계를 확인합니다.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"PpTsx9eawT"}],"key":"Kaa1iqofnL"},{"type":"code","lang":"r","value":"# 요약통계량 계산\nposition_summary <- players %>%\n  group_by(position) %>%\n  summarise(n = n(), mean_wOBA = mean(wOBA), sd_wOBA = sd(wOBA), .groups = \"drop\")\n\nprint(as.data.frame(position_summary), row.names = FALSE)\n\n# 상자그림 확인\nboxplot(wOBA ~ position, data = players, xlab = \"Position\", ylab = \"wOBA\")","key":"czAxVuEZgq"},{"type":"heading","depth":3,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"4. 분산분석","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"P7mfIeucia"}],"identifier":"id-4","label":"4. 분산분석","html_id":"id-4","implicit":true,"key":"HNtXXgvygM"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"포지션별 각 선수들의 wOBA 평균에 유의미한 차이가 있는지를 일원분산분석을 통해 검정합니다.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"ymHOD47mw9"}],"key":"qgO5YT13A0"},{"type":"code","lang":"r","value":"fit <- aov(wOBA ~ position, data = players)\nanova_table <- summary(fit)\nprint(anova_table)","key":"ygIhfWY5GI"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"분산분석에서 효과를 보고자 하는 변수가 다수준인 경우, 유의확률을 과대평가하게 됩니다. 이를 보정하는 여러 방법이 있는데, 가장 엄격한 방법으로 알려진 튜키(Tukey) 사후비교를 통해 쌍별 비교 결과를 검정할 수 있습니다.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"GGvqCcBMlo"}],"key":"jZqqL8rLAK"},{"type":"code","lang":"r","value":"p_value <- anova_table[[1L]][[\"Pr(>F)\"]][1L]\nif (p_value < 0.05) {\n  tukey <- as.data.frame(TukeyHSD(fit, \"position\")$position)\n  print(tukey[tukey[[\"p adj\"]] < 0.05, , drop = FALSE])\n}","key":"PU5aQLzGnB"},{"type":"heading","depth":3,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"5. 번외 : 핫코너와 센터라인","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"CmNd24PBTS"}],"identifier":"id-5","label":"5. 번외 : 핫코너와 센터라인","html_id":"id-5","implicit":true,"key":"T8XcKcXp2v"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"이번에는 1루수·3루수·좌익수·우익수를 ","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"vKXyAJhLMy"},{"type":"inlineCode","value":"hot_corner = 1","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"VC2jV4T3Z1"},{"type":"text","value":", 포수·2루수·유격수·중견수를 ","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"aJGTrSl6Kp"},{"type":"inlineCode","value":"hot_corner = 0","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"gvxyrQ2t4U"},{"type":"text","value":"으로 묶어 두 집단의 wOBA를 비교해보겠습니다. 주 포지션이 지명타자(DH)인 선수는 제외합니다.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"HJFstejFRE"}],"key":"ell5KpADkI"},{"type":"code","lang":"r","value":"hot_corner_players <- players %>%\n  filter(position != \"DH\") %>%\n  mutate(hot_corner = factor(\n    as.integer(position %in% c(\"1B\", \"3B\", \"LF\", \"RF\")), levels = 0:1\n  ))\n\nhot_corner_summary <- hot_corner_players %>%\n  group_by(hot_corner) %>%\n  summarise(n = n(), mean_wOBA = mean(wOBA), sd_wOBA = sd(wOBA), .groups = \"drop\")\nprint(as.data.frame(hot_corner_summary), row.names = FALSE)\n\nhot_corner_fit <- aov(wOBA ~ hot_corner, data = hot_corner_players)\nprint(summary(hot_corner_fit))","key":"FOmqZeHrq5"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"참고로, 일원분산분석에서 효과 변수가 이항 변수인 경우 분산분석은 등분산을 가정하는 이표본 양측 t검정과 동일한 결과를 가집니다.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"x3s9b40Ei3"}],"key":"tLhWHPrzwJ"},{"type":"code","lang":"r","value":"hot_corner_test <- with(hot_corner_players, t.test(\n  x = wOBA[hot_corner == \"1\"], y = wOBA[hot_corner == \"0\"],\n  var.equal = TRUE, alternative = \"two.sided\"\n))\nprint(hot_corner_test)","key":"DDc7oPj4g6"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"등분산 이표본 t 검정의 통계량과 두 집단 ANOVA의 통계량 사이에는 다음 같은 관계가 있습니다.","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"nxxoor8Ke3"}],"key":"rhuiuyUlDw"},{"type":"math","value":"t=\\frac{\\bar y_1-\\bar y_0}{s_p\\sqrt{1/n_1+1/n_0}},\n\\qquad\nF=\\frac{\\dfrac{n_0n_1}{n_0+n_1}(\\bar y_1-\\bar y_0)^2}{s_p^2}=t^2.","position