{"version":3,"kind":"Article","sha256":"bd32f0a9bc81c59e6d1f43070c914ed385bb337655476b9c07f6903083a6f940","slug":"r-oop","location":"/043-r_oop.md","dependencies":[],"frontmatter":{"title":"1.4.4. R 객체지향 프로그래밍","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/043-r_oop.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/043-r_oop.md","exports":[{"format":"md","filename":"043-r_oop.md","url":"/build/043-r_oop-8462069017754511a2fc6fac1d1e9802.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"R에는 S3, S4, R6 세 가지 주요 OOP 시스템이 있습니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rO96KzMGKx"}],"key":"JIl5WAGDto"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1.4.4.1. S3 (가장 간단하고 널리 사용)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CDf9l9R7Sa"}],"identifier":"id-1-4-4-1-s3","label":"1.4.4.1. S3 (가장 간단하고 널리 사용)","html_id":"id-1-4-4-1-s3","implicit":true,"key":"ksQTemFTkT"},{"type":"code","lang":"r","value":"# S3 객체 생성\nperson <- list(\n    name = \"Alice\",\n    age = 25\n)\nclass(person) <- \"Person\"\n\n# 메서드 정의\nprint.Person <- function(x) {\n    cat(\"Person:\\n\")\n    cat(\"  Name:\", x$name, \"\\n\")\n    cat(\"  Age:\", x$age, \"\\n\")\n}\n\nprint(person)\n\n# 생성자 함수\nPerson <- function(name, age) {\n    obj <- list(name = name, age = age)\n    class(obj) <- \"Person\"\n    obj\n}\n\nalice <- Person(\"Alice\", 25)\n\n# 메서드 추가\nsummary.Person <- function(x) {\n    cat(sprintf(\"%s is %d years old\\n\", x$name, x$age))\n}\n\nsummary(alice)\n\n# 메서드 확인\nmethods(class = \"Person\")\nmethods(print)","position":{"start":{"line":7,"column":1},"end":{"line":43,"column":1}},"key":"taiSFKa4uz"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"1.4.4.2. S4 (더 엄격하고 공식적)","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"IA7DYA6LvV"}],"identifier":"id-1-4-4-2-s4","label":"1.4.4.2. S4 (더 엄격하고 공식적)","html_id":"id-1-4-4-2-s4","implicit":true,"key":"GlSUibIM4u"},{"type":"code","lang":"r","value":"# 클래스 정의\nsetClass(\"Person\",\n    slots = c(\n        name = \"character\",\n        age = \"numeric\"\n    ),\n    prototype = list(\n        name = NA_character_,\n        age = NA_real_\n    )\n)\n\n# 객체 생성\nalice <- new(\"Person\", name = \"Alice\", age = 25)\n\n# 슬롯 접근\nalice@name\nslot(alice, \"name\")\n\n# 메서드 정의\nsetMethod(\"show\", \"Person\",\n    function(object) {\n        cat(\"Person:\\n\")\n        cat(\"  Name:\", object@name, \"\\n\")\n        cat(\"  Age:\", object@age, \"\\n\")\n    }\n)\n\n# 제네릭 함수 정의\nsetGeneric(\"greet\", function(x) standardGeneric(\"greet\"))\n\nsetMethod(\"greet\", \"Person\",\n    function(x) {\n        paste(\"Hello, I'm\", x@name)\n    }\n)\n\ngreet(alice)\n\n# 상속\nsetClass(\"Student\",\n    contains = \"Person\",\n    slots = c(\n        grade = \"numeric\"\n    )\n)\n\nbob <- new(\"Student\", name = \"Bob\", age = 20, grade = 85)","position":{"start":{"line":47,"column":1},"end":{"line":96,"column":1}},"key":"T455eF1Q6y"},{"type":"heading","depth":2,"position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"1.4.4.3. R6 (참조 클래스, 가장 OOP답)","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"kraO8m6DAq"}],"identifier":"id-1-4-4-3-r6-oop","label":"1.4.4.3. R6 (참조 클래스, 가장 OOP답)","html_id":"id-1-4-4-3-r6-oop","implicit":true,"key":"WdZt0atoX3"},{"type":"code","lang":"r","value":"library(R6)\n\n# 클래스 정의\nPerson <- R6Class(\"Person\",\n    public = list(\n        name = NULL,\n        age = NULL,\n        \n        # 생성자\n        initialize = function(name, age) {\n            self$name <- name\n            self$age <- age\n        },\n        \n        # 메서드\n        greet = function() {\n            cat(sprintf(\"Hello, I'm %s\\n\", self$name))\n        },\n        \n        print = function() {\n            cat(\"Person:\\n\")\n            cat(\"  Name:\", self$name, \"\\n\")\n            cat(\"  Age:\", self$age, \"\\n\")\n        }\n    ),\n    \n    # private 멤버\n    private = list(\n        .id = NULL\n    )\n)\n\n# 객체 생성\nalice <- Person$new(\"Alice\", 25)\nalice$greet()\nalice$name  # \"Alice\"\n\n# 상속\nStudent <- R6Class(\"Student\",\n    inherit = Person,\n    public = list(\n        grade = NULL,\n        \n        initialize = function(name, age, grade) {\n            super$initialize(name, age)\n            self$grade <- grade\n        },\n        \n        study = function() {\n            cat(sprintf(\"%s is studying\\n\", self$name))\n        }\n    )\n)\n\nbob <- Student$new(\"Bob\", 20, 85)\nbob$greet()\nbob$study()\n\n# 액티브 바인딩 (프로퍼티)\nBankAccount <- R6Class(\"BankAccount\",\n    private = list(\n        .balance = 0\n    ),\n    public = list(\n        deposit = function(amount) {\n            private$.balance <- private$.balance + amount\n        },\n        \n        withdraw = function(amount) {\n            if (amount <= private$.balance) {\n                private$.balance <- private$.balance - amount\n                return(TRUE)\n            }\n            FALSE\n        }\n    ),\n    active = list(\n        balance = function() {\n            private$.balance\n        }\n    )\n)\n\naccount <- BankAccount$new()\naccount$deposit(1000)\naccount$balance  # 1000 (읽기 전용)","position":{"start":{"line":100,"column":1},"end":{"line":187,"column":1}},"key":"ak2Ve9CpJ1"},{"type":"heading","depth":2,"position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"children":[{"type":"text","value":"1.4.4.4. 제네릭 메서드","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"tNRXtYb7X7"}],"identifier":"id-1-4-4-4","label":"1.4.4.4. 제네릭 메서드","html_id":"id-1-4-4-4","implicit":true,"key":"Ae7Zn4T1uf"},{"type":"code","lang":"r","value":"# S3 제네릭\nprint <- function(x, ...) UseMethod(\"print\")\nsummary <- function(x, ...) UseMethod(\"summary\")\n\n# 커스텀 제네릭\ndescribe <- function(x) UseMethod(\"describe\")\n\ndescribe.default <- function(x) {\n    cat(\"Object of class:\", class(x), \"\\n\")\n}\n\ndescribe.Person <- function(x) {\n    cat(sprintf(\"%s, %d years old\\n\", x$name, x$age))\n}\n\n# S4 제네릭\nsetGeneric(\"process\", function(x) standardGeneric(\"process\"))","position":{"start":{"line":191,"column":1},"end":{"line":209,"column":1}},"key":"aI8CgdfQAV"},{"type":"heading","depth":2,"position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"1.4.4.5. 시스템 비교","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"x7j0CQYjVF"}],"identifier":"id-1-4-4-5","label":"1.4.4.5. 시스템 비교","html_id":"id-1-4-4-5","implicit":true,"key":"DfkRqgdqmJ"},{"type":"table","position":{"start":{"line":213,"column":1},"end":{"line":219,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"children":[{"type":"text","value":"특징","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"FeXhMofWFw"}],"key":"KUiyHhQliq"},{"type":"tableCell","header":true,"position":{"start":{"line":213,"column":1},"