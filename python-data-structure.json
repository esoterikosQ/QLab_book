{"version":3,"kind":"Article","sha256":"c6972634c542d47a4450f0eab14e89b56823cb18829fe17c09031d57c4d8f9a7","slug":"python-data-structure","location":"/031-python_data_structure.md","dependencies":[],"frontmatter":{"title":"1.3.2. Python 자료구조","content_includes_title":false,"authors":[{"nameParsed":{"literal":"SeungGyu Bak","given":"SeungGyu","family":"Bak"},"name":"SeungGyu Bak","email":"seunggyu.bak@gmail.com","affiliations":["Q's Laboratory"],"id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/esoterikosQ/QLab_book","affiliations":[{"id":"Q's Laboratory","name":"Q's Laboratory"}],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/esoterikosQ/QLab_book/blob/main/031-python_data_structure.md","edit_url":"https://github.com/esoterikosQ/QLab_book/edit/main/031-python_data_structure.md","exports":[{"format":"md","filename":"031-python_data_structure.md","url":"/build/031-python_data_stru-c02316921f3c0401529e6a3804a9071d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Python의 기본 자료구조는 효율적인 데이터 저장과 처리의 핵심입니다.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Qnu6YIdihn"}],"key":"Lq70eTV2OI"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1.3.2.1. 리스트 (List)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"frOVjyO55m"}],"identifier":"id-1-3-2-1-list","label":"1.3.2.1. 리스트 (List)","html_id":"id-1-3-2-1-list","implicit":true,"key":"AdmilHzy2K"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"순서가 있고 변경 가능한(mutable) 시퀀스 자료형입니다.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"gqi3wFcMYy"}],"key":"d4e8cn6sbD"},{"type":"code","lang":"python","value":"# 생성\nnumbers = [1, 2, 3, 4, 5]\nmixed = [1, \"hello\", 3.14, True]\nnested = [[1, 2], [3, 4], [5, 6]]\nempty = []\n\n# 인덱싱\nprint(numbers[0])   # 1 (첫 요소)\nprint(numbers[-1])  # 5 (마지막 요소)\n\n# 슬라이싱\nprint(numbers[1:4])   # [2, 3, 4]\nprint(numbers[:3])    # [1, 2, 3]\nprint(numbers[3:])    # [4, 5]\nprint(numbers[::2])   # [1, 3, 5] (2칸씩)\nprint(numbers[::-1])  # [5, 4, 3, 2, 1] (역순)\n\n# 추가/삽입\nnumbers.append(6)         # [1, 2, 3, 4, 5, 6]\nnumbers.insert(0, 0)      # [0, 1, 2, 3, 4, 5, 6]\nnumbers.extend([7, 8])    # [0, 1, 2, 3, 4, 5, 6, 7, 8]\n\n# 삭제\nnumbers.remove(0)         # 값으로 삭제\npopped = numbers.pop()    # 마지막 요소 제거 및 반환\npopped = numbers.pop(0)   # 인덱스 0 제거\ndel numbers[0]            # 인덱스로 삭제\nnumbers.clear()           # 모두 삭제\n\n# 검색\nfruits = ['apple', 'banana', 'cherry']\nprint('apple' in fruits)       # True\nprint(fruits.index('banana'))  # 1\nprint(fruits.count('apple'))   # 1\n\n# 정렬\nnums = [3, 1, 4, 1, 5, 9, 2, 6]\nnums.sort()                    # 원본 변경\nprint(nums)                    # [1, 1, 2, 3, 4, 5, 6, 9]\n\nsorted_nums = sorted(nums, reverse=True)  # 새 리스트 반환\nprint(sorted_nums)             # [9, 6, 5, 4, 3, 2, 1, 1]\n\n# 리스트 컴프리헨션\nsquares = [x**2 for x in range(10)]\nevens = [x for x in range(20) if x % 2 == 0]\nmatrix = [[i*j for j in range(3)] for i in range(3)]\n\n# 중첩 리스트 평탄화\nnested = [[1, 2], [3, 4], [5, 6]]\nflat = [item for sublist in nested for item in sublist]\nprint(flat)  # [1, 2, 3, 4, 5, 6]","position":{"start":{"line":9,"column":1},"end":{"line":62,"column":1}},"key":"m0Cj2N3Aq5"},{"type":"heading","depth":2,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"1.3.2.2. 튜플 (Tuple)","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"DtMfIfCJ7s"}],"identifier":"id-1-3-2-2-tuple","label":"1.3.2.2. 튜플 (Tuple)","html_id":"id-1-3-2-2-tuple","implicit":true,"key":"H8OYU9wQsU"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"순서가 있고 변경 불가능한(immutable) 시퀀스 자료형입니다.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"LhyM0u5gv1"}],"key":"MWBeLKVYKH"},{"type":"code","lang":"python","value":"# 생성\npoint = (3, 4)\nsingle = (1,)      # 단일 요소 튜플은 쉼표 필수\ncoordinates = (10.0, 20.0, 30.0)\n\n# 언패킹\nx, y = point\nprint(x, y)  # 3 4\n\n# 여러 값 반환\ndef get_stats(numbers):\n    return min(numbers), max(numbers), sum(numbers)\n\nminimum, maximum, total = get_stats([1, 2, 3, 4, 5])\n\n# 스왑\na, b = 10, 20\na, b = b, a  # swap\nprint(a, b)  # 20 10\n\n# 네임드 튜플\nfrom collections import namedtuple\n\nPoint = namedtuple('Point', ['x', 'y'])\np = Point(3, 4)\nprint(p.x, p.y)  # 3 4\nprint(p[0], p[1])  # 3 4\n\nPerson = namedtuple('Person', 'name age city')\nperson = Person('Alice', 25, 'Seoul')\nprint(person.name)  # Alice","position":{"start":{"line":68,"column":1},"end":{"line":100,"column":1}},"key":"jfeBJ3hgQz"},{"type":"heading","depth":2,"position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"1.3.2.3. 딕셔너리 (Dictionary)","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"jjUwlPVmh5"}],"identifier":"id-1-3-2-3-dictionary","label":"1.3.2.3. 딕셔너리 (Dictionary)","html_id":"id-1-3-2-3-dictionary","implicit":true,"key":"r1Il6Wi7gL"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"키-값 쌍을 저장하는 변경 가능한 자료형입니다 (Python 3.7+부터 삽입 순서 유지).","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"s2un6g7KQJ"}],"key":"NfEVpLJX32"},{"type":"code","lang":"python","value":"# 생성\nstudent = {\n    'name': 'Alice',\n    'age': 20,\n    'grade': 'A',\n    'courses': ['Math', 'Physics']\n}\n\n# dict() 생성자\nperson = dict(name='Bob', age=30)\n\n# 접근\nprint(student['name'])  # Alice\nprint(student.get('age'))  # 20\nprint(student.get('email', 'N/A'))  # 없으면 기본값 'N/A'\n\n# 추가/수정\nstudent['email'] = 'alice@example.com'\nstudent['age'] = 21\n\n# 삭제\ndel student['grade']\nemail = student.pop('email')  # 제거 및 반환\nlast_item = student.popitem()  # 마지막 항목 제거\n\n# 키 확인\nprint('name' in student)  # True\n\n# 순회\nfor key in student:\n    print(f\"{key}: {student[key]}\")\n\nfor key, value in student.items():\n    print(f\"{key}: {value}\")\n\nfor key in student.keys():\n    print(key)\n\nfor value in student.values():\n    print(value)\n\n# 병합 (Python 3.9+)\ndict1 = {'a': 1, 'b': 2}\ndict2 = {'b': 3, 'c': 4}\nmerged = dict1 | dict2  # {'a': 1, 'b': 3, 'c': 4}\n\n# update\ndict1.update(dict2)\n\n# 딕셔너리 컴프리헨션\nsquares = {x: x**2 for x in range(5)}  # {0: 0, 1: 1, 2: 4, 3: 9, 4: 16}\n\n# DefaultDict (자동 초기화)\nfrom collections import defaultdict\n\nword_count = defaultdict(int)\nfor word in ['apple', 'banana', 'apple']:\n    word_count[word] += 1\nprint(dict(word_count))  # {'apple': 2, 'banana': 1}\n\n# Counter (빈도 계산)\nfrom collections import Counter\n\nwords = ['apple', 'banana', 'apple', 'cherry', 'banana', 'apple']\ncounter = Counter(words)\nprint(counter)  # Counter({'apple': 3, 'banana': 2, 'cherry': 1})\nprint(counter.most_common(2))  # [('apple', 3), ('banana', 2)]","position":{"start":{"line":106,"column":1},"end":{"line":174,"column":1}},"key":"GuZEsaYypr"},{"type":"heading","depth":2,"position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"1.3.2.4. 집합 (Set)","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"R40kuVt3TV"}],"identifier":"id-1-3-2-4-set","label":"1.3.2.4. 집합 (Set)","html_id":"id-1-3-2-4-set","implicit":true,"key":"f3xwMFV48A"},{"type":"paragraph","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"중복을 허용하지 않는 순서 없는 자료형입니다.","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"fNpdeLCHIF"}],"key":"Jcd8esDizy"},{"type":"code","lang":"python","value":"# 생성\nfruits = {'apple', 'banana', 'cherry'}\nnums = set([1, 2, 2, 3, 3, 3])  # {1, 2, 3}\nempty = set()  # 빈 집합 ({}는 딕셔너리)\n\n# 추가/삭제\nfruits.add('orange')\nfruits.remove('banana')  # 없으면 KeyError\nfruits.discard('grape')  # 없어도 오류 없음\nitem = fruits.pop()      # 임의 요소 제거\n\n# 집합 연산\na = {1, 2, 3, 4}\nb = {3, 4, 5, 6}\n\nprint(a | b)  # 합집합: {1, 2, 3, 4, 5, 6}\nprint(a & b)  # 교집합: {3, 4}\nprint(a - b)  # 차집합: {1, 2}\nprint(a ^ b)  # 대칭차집합: {1, 2, 5, 6}\n\n# 메서드\nprint(a.union(b))\nprint(a.intersection(b))\nprint(a.difference(b))\nprint(a.symmetric_difference(b))\n\n# 부분집합 확인\nprint({1, 2}.issubset(a))     # True\nprint(a.issuperset({1, 2}))   # True\nprint(a.isdisjoint(b))        # False (공통 요소 있음)\n\n# 중복 제거\nnumbers = [1, 2, 2, 3, 3, 3, 4, 4, 4, 4]\nunique = list(set(numbers))   # [1, 2, 3, 4]\n\n# frozenset (불변 집합)\nfrozen = frozenset([1, 2, 3])\n# frozen.add(4)  # AttributeError (변경 불가)","position":{"start":{"line":180,"column":1},"end":{"line":219,"column":1}},"key":"XqcgZszybJ"},{"type":"heading","depth":2,"position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"children":[{"type":"text","value":"1.3.2.5. 문자열 (String)","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"HgdabQs2hT"}],"identifier":"id-1-3-2-5-string","label":"1.3.2.5. 문자열 (String)","html_id":"id-1-3-2-5-string","implicit":true,"key":"xM5rsASEqt"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"children":[{"type":"text","value":"문자열은 불변 시퀀스입니다.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"k49WjIQcPV"}],"key":"wJFBiajIui"},{"type":"code","lang":"python","value":"# 생성\ntext = \"Hello, World!\"\nmultiline = \"\"\"여러 줄\n문자열\"\"\"\n\n# 인덱싱/슬라이싱\nprint(text[0])      # H\nprint(text[-1])     # !\nprint(text[0:5])    # Hello\n\n# 메서드\nprint(text.lower())            # hello, world!\nprint(text.upper())            # HELLO, WORLD!\nprint(text.replace('World', 'Python'))  # Hello, Python!\nprint(text.split(','))         # ['Hello', ' World!']\nprint('-'.join(['a', 'b', 'c']))  # a-b-c\n\n# 검색\nprint('World' in text)         # True\nprint(text.startswith('Hello'))  # True\nprint(text.endswith('!'))      # True\nprint(text.find('World'))      # 7\nprint(text.index('World'))     # 7\n\n# 공백 제거\ntext = \"  hello  \"\nprint(text.strip())   # \"hello\"\nprint(text.lstrip())  # \"hello  \"\nprint(text.rstrip())  # \"  hello\"\n\n# 포매팅\nname = \"Alice\"\nage = 25\n\n# f-string (Python 3.6+, 권장)\nprint(f\"{name} is {age} years old\")\nprint(f\"{age * 2 = }\")  # age * 2 = 50 (Python 3.8+)\n\n# format\nprint(\"{} is {} years old\".format(name, age))\nprint(\"{name} is {age} years old\".format(name=name, age=age))\n\n# % 포매팅 (옛날 방식)\nprint(\"%s is %d years old\" % (name, age))\n\n# 정렬/패딩\nprint(f\"{age:5}\")    # \"   25\"\nprint(f\"{age:05}\")   # \"00025\"\nprint(f\"{3.14159:.2f}\")  # \"3.14\"","position":{"start":{"line":225,"column":1},"end":{"line":275,"column":1}},"key":"UwUme2XSSa"},{"type":"heading","depth":2,"position":{"start":{"line":277,"column":1},"end":{"line":277,"column":1}},"children":[{"type":"text","value":"1.3.2.6. 고급 자료구조 (collections 모듈)","position":{"start":{"line":277,"column":1},"end":{"line":277,"column":1}},"key":"DQcYLCfxGH"}],"identifier":"id-1-3-2-6-collections","label":"1.3.2.6. 고급 자료구조 (collections 모듈)","html_id":"id-1-3-2-6-collections","implicit":true,"key":"vLX2NIk0Iv"},{"type":"heading","depth":3,"position":{"start":{"line":279,"column":1},"end":{"line":279,"column":1}},"children":[{"type":"text","value":"deque (양방향 큐)","position":{"start":{"line":279,"column":1},"end":{"line":279,"column":1}},"key":"FfMeGAhnfb"}],"identifier":"deque","label":"deque (양방향 큐)","html_id":"deque","implicit":true,"key":"mckQ1NGaqP"},{"type":"code","lang":"python","value":"from collections import deque\n\n# 생성\ndq = deque([1, 2, 3])\n\n# 양쪽에서 추가/제거\ndq.append(4)        # 오른쪽에 추가\ndq.appendleft(0)    # 왼쪽에 추가\ndq.pop()            # 오른쪽에서 제거\ndq.popleft()        # 왼쪽에서 제거\n\n# 회전\ndq.rotate(1)        # 오른쪽으로 1칸 회전\ndq.rotate(-1)       # 왼쪽으로 1칸 회전\n\nprint(dq)  # deque([1, 2, 3])","position":{"start":{"line":281,"column":1},"end":{"line":298,"column":1}},"key":"i2erOSPbRH"},{"type":"heading","depth":3,"position":{"start":{"line":300,"column":1},"end":{"line":300,"column":1}},"children":[{"type":"text","value":"OrderedDict (순서 유지 딕셔너리)","position":{"start":{"line":300,"column":1},"end":{"line":300,"column":1}},"key":"fhmX4QAUit"}],"identifier":"ordereddict","label":"OrderedDict (순서 유지 딕셔너리)","html_id":"ordereddict","implicit":true,"key":"ABfYsxjRmw"},{"type":"code","lang":"python","value":"from collections import OrderedDict\n\n# Python 3.7+에서는 일반 dict도 순서 유지\n# OrderedDict는 순서 변경 메서드 제공\nod = OrderedDict()\nod['a'] = 1\nod['b'] = 2\nod['c'] = 3\n\n# 마지막/처음 항목 이동\nod.move_to_end('a')  # a를 맨 끝으로\nod.move_to_end('b', last=False)  # b를 맨 앞으로","position":{"start":{"line":302,"column":1},"end":{"line":315,"column":1}},"key":"ifJauHzgFP"},{"type":"heading","depth":3,"position":{"start":{"line":317,"column":1},"end":{"line":317,"column":1}},"children":[{"type":"text","value":"ChainMap (여러 딕셔너리 연결)","position":{"start":{"line":317,"column":1},"end":{"line":317,"column":1}},"key":"l8OEho7l6S"}],"identifier":"chainmap","label":"ChainMap (여러 딕셔너리 연결)","html_id":"chainmap","implicit":true,"key":"Oymw3r9pCj"},{"type":"code","lang":"python","value":"from collections import ChainMap\n\ndict1 = {'a': 1, 'b': 2}\ndict2 = {'b': 3, 'c': 4}\nchain = ChainMap(dict1, dict2)\n\nprint(chain['b'])  # 2 (첫 번째 딕셔너리 우선)\nprint(list(chain))  # ['b', 'c', 'a']","position":{"start":{"line":319,"column":1},"end":{"line":328,"column":1}},"key":"MkrbbugUrQ"},{"type":"heading","depth":2,"position":{"start":{"line":330,"column":1},"end":{"line":330,"column":1}},"children":[{"type":"text","value":"1.3.2.7. 시간 복잡도","position":{"start":{"line":330,"column":1},"end":{"line":330,"column":1}}