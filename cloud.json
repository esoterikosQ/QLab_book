oud-cli-ubuntu-24-04","label":"gcloud CLI 설치 (Ubuntu 24.04)","html_id":"gcloud-cli-ubuntu-24-04","implicit":true,"key":"kaaPfkN74U"},{"type":"code","lang":"bash","value":"# Google Cloud SDK 설치\ncurl https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg\necho \"deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main\" | sudo tee -a /etc/apt/sources.list.d/google-cloud-sdk.list\nsudo apt update\nsudo apt install google-cloud-cli\n\n# 초기화 및 인증\ngcloud init\ngcloud auth login","position":{"start":{"line":9,"column":1},"end":{"line":19,"column":1}},"key":"vCZrQsEjGt"},{"type":"heading","depth":3,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"주요 서비스","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"JnVfW1N7E2"}],"identifier":"id","label":"주요 서비스","html_id":"id","implicit":true,"key":"sQvXitupc0"},{"type":"heading","depth":4,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Compute Engine (VM 인스턴스)","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"p26gLf8WVo"}],"identifier":"compute-engine-vm","label":"Compute Engine (VM 인스턴스)","html_id":"compute-engine-vm","implicit":true,"key":"r02wmUZ8HK"},{"type":"code","lang":"bash","value":"# VM 인스턴스 생성\ngcloud compute instances create my-instance \\\n  --zone=us-central1-a \\\n  --machine-type=e2-medium \\\n  --image-family=ubuntu-2404-lts-amd64 \\\n  --image-project=ubuntu-os-cloud\n\n# SSH 접속\ngcloud compute ssh my-instance --zone=us-central1-a\n\n# 인스턴스 중지/시작\ngcloud compute instances stop my-instance --zone=us-central1-a\ngcloud compute instances start my-instance --zone=us-central1-a\n\n# 인스턴스 삭제\ngcloud compute instances delete my-instance --zone=us-central1-a","position":{"start":{"line":25,"column":1},"end":{"line":42,"column":1}},"key"